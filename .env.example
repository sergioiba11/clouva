# Supabase público para la web de CLOUVA.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo GitHub Actions para publicar APK privados. NUNCA usar NEXT_PUBLIC_ ni incluir en la app.
SUPABASE_SERVICE_ROLE_KEY=

# Google Identity Services (botón "Continuar con Google" en /login).
# Client ID público (tipo "Aplicación web") del proyecto de Google Cloud.
# No requiere Client Secret en el frontend -- Supabase valida el ID token server-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# CLOUVA Avatar Engine remote assets
# Required for demo mode and for showing the active avatar on /mi-flow/avatar and home.
# Use a public HTTPS URL to a GLB/GLTF humanoid model, optimized for web/mobile.
NEXT_PUBLIC_AVATAR_BASE_URL=

# Optional modular pieces. If empty, their locker categories stay visible but locked as "Próximamente".
NEXT_PUBLIC_AVATAR_HAIR_URL=
NEXT_PUBLIC_AVATAR_TOP_URL=
NEXT_PUBLIC_AVATAR_BOTTOM_URL=
NEXT_PUBLIC_AVATAR_SHOES_URL=

# Temporary demo mode: when true, the engine loads only NEXT_PUBLIC_AVATAR_BASE_URL as one complete humanoid.
NEXT_PUBLIC_AVATAR_DEMO_MODE=true

# CLOUVA CONTROL — variables públicas incorporadas al APK.
EXPO_PUBLIC_CLOUVA_API_URL=https://clouva.com.ar
EXPO_PUBLIC_SUPABASE_URL=
# Preferir la publishable key moderna. Para compatibilidad puede usarse la anon key pública.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Versión nativa. El workflow las completa automáticamente.
CLOUVA_CONTROL_VERSION=1.0.0
CLOUVA_CONTROL_BUILD_NUMBER=1

# Firma Android. Solo CI o entorno local seguro; nunca commitear estos valores ni el keystore.
CLOUVA_CONTROL_KEYSTORE_PATH=
CLOUVA_CONTROL_KEY_ALIAS=
CLOUVA_CONTROL_KEYSTORE_PASSWORD=
CLOUVA_CONTROL_KEY_PASSWORD=
