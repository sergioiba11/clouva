# Supabase público para la web de CLOUVA.
NEXT_PUBLIC_SUPABASE_URL=
# Preferida para clientes nuevos; la anon key se mantiene como fallback compatible.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo GitHub Actions para publicar APK privados. NUNCA usar NEXT_PUBLIC_ ni incluir en la app.
SUPABASE_SERVICE_ROLE_KEY=

# Email transaccional server-side para invitaciones de Agenda.
# Verificar clouva.com.ar en el proveedor antes de usar admin@clouva.com.ar como remitente.
RESEND_API_KEY=
CLOUVA_EMAIL_FROM="CLOUVA <admin@clouva.com.ar>"
CLOUVA_APP_URL=https://clouva.com.ar

# IGLÚ RADIO. Dejar vacío hasta tener la URL oficial del stream: la UI mostrará OFFLINE sin inventar señal.
NEXT_PUBLIC_IGLU_RADIO_STREAM_URL=

# Trébol / CLOUVA AI. GEMINI_API_KEY es secreto y sólo vive en Cloud Run/local seguro.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
TREBOL_LIVE_VOICE=Kore
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_IMAGE_GENERATION_ENABLED=true
CLOUVA_GENERATED_MEDIA_BUCKET=clouva-generated-media

# CLOUVA Cloud Video Engine — Vertex AI + Cloud Tasks + Cloud Run FFmpeg.
# Vertex usa ADC / service account del entorno; no agregar credenciales públicas.
GOOGLE_CLOUD_PROJECT=
VERTEX_VIDEO_LOCATION=us-central1
CLOUVA_GCP_PROJECT=
CLOUVA_GCP_REGION=us-central1
CLOUVA_VIDEO_QUEUE_NAME=clouva-video-generation
VIDEO_PROJECT_TASK_SECRET=
CLOUVA_VIDEO_RENDER_JOB_NAME=clouva-video-render
CLOUVA_VIDEO_MAX_PARALLEL=2

# Asset Explorer — importación ZIP persistente.
# El browser sube directo a GCS por una sesión resumible; Cloud Tasks dispara el worker server-side.
CLOUVA_ADMIN_ASSETS_BUCKET=clouva-generated-media
CLOUVA_ASSET_IMPORT_TASKS_PROJECT=gen-lang-client-0737053175
CLOUVA_ASSET_IMPORT_TASKS_LOCATION=us-central1
CLOUVA_ASSET_IMPORT_TASKS_QUEUE=clouva-asset-imports
CLOUVA_ASSET_IMPORT_WORKER_URL=https://clouva.com.ar/api/internal/admin/assets/imports/process
# Secreto server-side compartido sólo por Cloud Tasks y el endpoint worker. Guardarlo en Secret Manager.
CLOUVA_ASSET_IMPORT_WORKER_SECRET=

# Acceso temporal a Proyecto/Workspace. Nunca exponer estos valores al navegador.
CLOUVA_ADMIN_EMAILS=
GITHUB_TOKEN=
WORKSPACE_DEVICE_TOKEN_ENCRYPTION_KEY=
CLOUVA_CONTROL_GATEWAY_URL=

# Google Maps Platform — Structures / 3D espacial.
# API key pública del navegador. Restringir por HTTP referrer a clouva.com.ar
# y permitir solamente Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID JavaScript Vector del mismo proyecto de Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google Identity Services (botón "Continuar con Google" en /login).
# Client ID público (tipo "Aplicación web") del proyecto de Google Cloud.
# No requiere Client Secret en el frontend -- Supabase valida el ID token server-side.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# YouTube OAuth para conectar el canal del Player. Todo salvo el Client ID es server-side.
# El mismo Google OAuth Client ID puede reutilizarse si tiene registrado YOUTUBE_REDIRECT_URI.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_ENCRYPTION_KEY=
YOUTUBE_TOKEN_KEY_VERSION=v1
YOUTUBE_REDIRECT_URI=https://clouva.com.ar/api/integrations/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.readonly
CLOUVA_YOUTUBE_ENABLED=true

# CLOUVA Avatar Engine remote assets
# Required for demo mode and for showing the active avatar on /mi-flow/avatar and home.
# Use a public HTTPS URL to a GLB/GLTF humanoid model, optimized for web/mobile.
NEXT_PUBLIC_AVATAR_BASE_URL=

# Optional modular pieces. If empty, their locker categories stay visible but locked as "Próximamente".
NEXT_PUBLIC_AVATAR_HAIR_URL=
NEXT_PUBLIC_AVATAR_TOP_URL=
NEXT_PUBLIC_AVATAR_BOTTOM_URL=
NEXT_PUBLIC_AVATAR_SHOES_URL=

# Temporary demo mode: when true, the engine loads only NEXT_PUBLIC_AVATAR_BASE_URL as one complete humanoid.
NEXT_PUBLIC_AVATAR_DEMO_MODE=true

# CLOUVA CONTROL — variables públicas incorporadas al APK.
EXPO_PUBLIC_CLOUVA_API_URL=https://clouva.com.ar
EXPO_PUBLIC_SUPABASE_URL=
# Preferir la publishable key moderna. Para compatibilidad puede usarse la anon key pública.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Versión nativa. El workflow las completa automáticamente.
CLOUVA_CONTROL_VERSION=1.0.0
CLOUVA_CONTROL_BUILD_NUMBER=1

# Firma Android. Solo CI o entorno local seguro; nunca commitear estos valores ni el keystore.
CLOUVA_CONTROL_KEYSTORE_PATH=
CLOUVA_CONTROL_KEY_ALIAS=
CLOUVA_CONTROL_KEYSTORE_PASSWORD=
CLOUVA_CONTROL_KEY_PASSWORD=

# Gemini server-side. Nunca usar NEXT_PUBLIC_ para esta clave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Opcional: permite elegir un modelo multimodal distinto para el escáner visual de productos.
GEMINI_PRODUCT_VISION_MODEL=gemini-3.5-flash